# Optional. The Calls page stores these in the browser you are using.
# GitHub Pages has no server, so a value here is not uploaded with the site
# and is not visible to visitors. The test suite reads them from the environment.
#
# OpenAI-compatible base URL of the quota-aware Arbiter gateway.
# No trailing slash. Example: http://127.0.0.1:8787
ARBITER_BASE_URL=
ARBITER_API_KEY=
# Virtual model Arbiter routes with quota awareness.
ARBITER_MODEL=auto
